  "version": "0.2",
  "language": "es,en",
  "ignorePaths": [
    "node_modules",
    "dist",
    "build",
    "**/pnpm-lock.yaml",
    "**/openapi.json",
    "**/*.pdf",
    "**/*.png",
    "**/figuras/render",
    "**/*.mmd",
    ".vscode/extensions.json",
    "recursos-uct",
    "historico",
