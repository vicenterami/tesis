    canal {
        uuid id PK
        uuid dispositivo_id FK
        text magnitud_codigo FK
        text etiqueta
        timestamptz actualizado_en
    }
    condicion {
        uuid id PK
        uuid dispositivo_id FK
        uuid regla_id FK
        text tipo
        timestamptz abierta_en
        timestamptz cerrada_en
    }
    credencial {
        uuid id PK
        uuid dispositivo_id FK
        text hash
        bool activa
        timestamptz creada_en
        timestamptz actualizado_en
    }
    cuarentena {
        uuid id PK
        text origen
        text topico
        text motivo
        bytea payload_crudo
        timestamptz recibido_en PK
        text detalle
        uuid dispositivo_id FK
    }
    dispositivo {
        uuid id PK
        uuid zona_id FK
        text id_fisico
        text nombre
        text estado
        int intervalo_esperado_s
        timestamptz visto_por_ultima_vez
        timestamptz creado_en
        timestamptz actualizado_en
    }
    evento {
        uuid id PK
        uuid dispositivo_id FK
        text tipo
        jsonb detalle
        timestamptz ocurrido_en
    }
    magnitud {
        text codigo PK
        text nombre
        text unidad_canonica
        float rango_min
        float rango_max
        timestamptz actualizado_en
    }
    medicion {
        uuid canal_id FK
        timestamptz tiempo
        float valor
        text unidad
        timestamptz recibido_en
        text origen_tiempo
    }
    regla_umbral {
        uuid id PK
        uuid canal_id FK
        float umbral_alto
        float umbral_bajo
        float histeresis
        timestamptz actualizado_en
    }
    sitio {
        uuid id PK
        text nombre
        text descripcion
        timestamptz creado_en
        text zona_horaria
        timestamptz actualizado_en
        bool activo
    }
    trama {
        uuid id PK
        uuid dispositivo_id FK
        timestamptz recibido_en PK
        text topico
        bytea payload
        text adaptador
    }
    usuario {
        uuid id PK
        text nombre
        text email
        text hash_password
        timestamptz creado_en
        timestamptz actualizado_en
        bool activo
    }
    usuario_sitio {
        uuid usuario_id PK,FK
        uuid sitio_id PK,FK
        text rol
        timestamptz actualizado_en
    }
    zona {
        uuid id PK
        uuid sitio_id FK
        text nombre
        timestamptz actualizado_en
    }
