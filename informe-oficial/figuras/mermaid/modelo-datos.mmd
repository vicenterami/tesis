    canal {
        uuid id PK
        uuid dispositivo_id FK
        text magnitud_codigo FK
        text etiqueta
        timestamptz actualizado_en
        float escala_cero
        float escala_cien
    }
    condicion {
        uuid id PK
        uuid dispositivo_id FK
        uuid regla_id FK
        text tipo
        timestamptz abierta_en
        timestamptz cerrada_en
    }
    condicion_sistema {
        uuid id PK
        text tipo
        jsonb detalle
        timestamptz abierta_en
        timestamptz cerrada_en
    }
    credencial {
        uuid id PK
        uuid dispositivo_id FK
        text hash
        bool activa
        timestamptz creada_en
        timestamptz actualizado_en
        uuid pasarela_id FK
    }
    cuarentena {
        uuid id PK
        text origen
        text topico
        text motivo
        bytea payload_crudo
        timestamptz recibido_en PK
        text detalle
        uuid dispositivo_id FK
    }
    dispositivo {
        uuid id PK
        uuid zona_id FK
        text id_fisico
        text nombre
        text estado
        int intervalo_esperado_s
        timestamptz visto_por_ultima_vez "deprecada"
        timestamptz creado_en
        timestamptz actualizado_en
        text via
        text formato FK
        uuid pasarela_id FK
        text decodificador
    }
    estado_dispositivo {
        uuid dispositivo_id PK,FK
        timestamptz visto_por_ultima_vez
        bigint ultimo_fcnt
    }
    evento {
        uuid id PK
        uuid dispositivo_id FK
        text tipo
        jsonb detalle
        timestamptz ocurrido_en
    }
    magnitud {
        text codigo PK
        text nombre
        text unidad_canonica
        float rango_min
        float rango_max
        timestamptz actualizado_en
    }
    medicion {
        uuid canal_id FK
        timestamptz tiempo
        float valor
        text unidad
        timestamptz recibido_en
        text origen_tiempo
    }
    metrica_broker {
        timestamptz tiempo PK
        bigint mensajes_descartados
        int mensajes_en_cola
        bigint bytes_en_cola
        int clientes_conectados
        bigint memoria_bytes
    }
    pasarela {
        uuid id PK
        uuid sitio_id FK
        text id_fisico
        text nombre
        bool activo
        timestamptz visto_por_ultima_vez
        timestamptz creado_en
        timestamptz actualizado_en
        text formato
    }
    regla_umbral {
        uuid id PK
        uuid canal_id FK
        float umbral_alto
        float umbral_bajo
        float histeresis
        timestamptz actualizado_en
    }
    sitio {
        uuid id PK
        text nombre
        text descripcion
        timestamptz creado_en
        text zona_horaria
        timestamptz actualizado_en
        bool activo
        text codigo
    }
    trama {
        uuid id PK
        uuid dispositivo_id FK
        timestamptz recibido_en PK
        text topico
        bytea payload
        text adaptador
    }
    usuario {
        uuid id PK
        text nombre
        text email
        text hash_password
        timestamptz creado_en
        timestamptz actualizado_en
        bool activo
    }
    usuario_sitio {
        uuid usuario_id PK,FK
        uuid sitio_id PK,FK
        text rol
        timestamptz actualizado_en
    }
    zona {
        uuid id PK
        uuid sitio_id FK
        text nombre
        timestamptz actualizado_en
    }
