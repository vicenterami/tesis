// Plantilla de include/secretos.h (fase 2, docs/17 §6.2 y §6.4). Copiar a include/secretos.h y completar; git ignora ese archivo
// (.gitignore) y NUNCA se versiona con valores reales.
//   cp include/secretos.h.ejemplo include/secretos.h
// Desde el 25/11/2026 lo único obligatorio es la CA: la red, el servidor, el sitio, el identificador y la credencial se cargan por USB
// (desde el panel, «Cargar en el equipo», o con herramientas/cargar-equipo.py) y quedan en la memoria no volátil del equipo. Así la imagen
// es UNA por instalación y no lleva secretos de ningún equipo. Si se descomentan las macros de abajo, valen como valores por omisión
// mientras no se cargue nada por USB (y `borrar` vuelve a ellas); entonces el binario (.pio/build/nodo/firmware.bin y .elf) las lleva en
// claro: no se entrega ni se sube.
#pragma once

// Opcional: valores por omisión (los cinco de identidad y red deben estar todos para que se usen).
// #define WIFI_SSID         "nombre-de-la-red-wifi"
// #define WIFI_CLAVE        "clave-de-la-red-wifi"
// #define MQTT_HOST         "direccion-del-servidor"
// #define MQTT_PUERTO       8883
// #define SITIO             "uct"
// #define DISPOSITIVO_ID    "nodo-0001"
// #define DISPOSITIVO_CLAVE "la-credencial-que-devolvio-el-alta"

// Opcional: servidor NTP (por omisión, pool.ntp.org). Sin hora no se publica la marca de tiempo (bt) y el backend usa la hora de
// recepción (docs/13 regla 7).
// #define NTP_SERVIDOR      "pool.ntp.org"

// Obligatorio: la CA de la instalación (en desarrollo, privado/certs-desarrollo/ca.crt), pegada tal cual entre los delimitadores: solo el
// certificado público, nunca una .key. Con ella el nodo verifica el certificado del proxy (nombre «proxy» de su SAN).
static const char CA_PEM[] = R"CA(
-----BEGIN CERTIFICATE-----
PEGAR AQUI EL CONTENIDO DE ca.crt
-----END CERTIFICATE-----
)CA";
