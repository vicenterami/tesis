{
  // TypeScript del proyecto (versión fijada en package.json), no el que trae VS Code:
  // así los avisos que ves son los mismos que ve la compilación.
  "js/ts.tsdk.path": "plataforma/backend/node_modules/typescript/lib",
  "js/ts.tsdk.promptToUseWorkspaceVersion": true,

  // LaTeX: compilar con latexmk en build/, como en la terminal
  "latex-workshop.latex.outDir": "%DIR%/build",
  "latex-workshop.latex.recipe.default": "latexmk",
  "latex-workshop.latex.autoBuild.run": "never",

  "files.exclude": { "**/node_modules": true, "**/dist": true, "**/build": true },
  "search.exclude": { "**/node_modules": true, "**/dist": true, "**/build": true, "historico/**": true },
  "files.insertFinalNewline": true,
  "files.trimTrailingWhitespace": true,
  "editor.rulers": [100],
  "cSpell.language": "es,en",
  "cSpell.words": [
    "Mosquitto", "TimescaleDB", "Timescale", "ChirpStack", "LoRaWAN", "SenML", "hypertable", "NestJS", "uPlot",
    "Svelte", "ThingsBoard", "pnpm", "eslint", "typecheck", "jest", "mqtt", "timestamptz", "uuid", "PBKDF",
    "Hetzner", "PPDIOO", "SWEBOK", "Cardiff", "Rivas", "Canto", "Villanueva", "latexmk", "adjustbox", "booktabs",
    "longtable", "toprule", "midrule", "bottomrule", "tabcolsep", "includegraphics", "keepaspectratio",
    "resizebox", "textbf", "texttt", "parencite", "Overfull", "hbox", "Mermaid", "openapi", "swagger",
    "histéresis", "cuarentena", "multiprotocolo", "bierner", "azuretools", "semiabierto", "semiabiertos", "idempotente", "idempotentes", "backlog"
  ],
  "cSpell.ignorePaths": [
    "**/node_modules", "**/dist", "**/build", "**/pnpm-lock.yaml", "**/openapi.json", "**/*.pdf", "**/*.png",
    "**/figuras/render", "**/*.mmd", ".vscode/extensions.json", "recursos-uct", "historico"
  ]
}
