# Versiones fijadas de la comparación medida (docs/23 §2 y §3.2). Las lee cada guion de esta carpeta (`. versiones.env`).
# Regla: ninguna versión con menos de 7 días de publicada a la fecha del protocolo (25/11/2026); cada imagen por digest de índice.
# Cambiar una línea de este archivo después del congelamiento es un cambio de protocolo: se anota en docs/23 §10 con su motivo.

# ── La máquina ─────────────────────────────────────────────────────────────────────────────────────────────────────────────
# Ubuntu Server 24.04 LTS para la nube, compilación del 17/10/2026 (la carpeta release-AAAAMMDD no cambia después de publicada).
IMAGEN_NUBE_URL=https://cloud-images.ubuntu.com/releases/noble/release-20261017/ubuntu-24.04-server-cloudimg-amd64.img
IMAGEN_NUBE_SHA256=04e8f2461a16a44e78a370284471f29616cdd9baf1893df25807b71f985b6c94
IMAGEN_NUBE_ARCHIVO=ubuntu-24.04-server-cloudimg-amd64-20261017.img
# Docker desde el repositorio oficial de Docker para noble, versión fijada y retenida (apt-mark hold).
DOCKER_CE=5:29.10.0-1~ubuntu.24.04~noble
CONTAINERD=2.4.2-4~ubuntu.24.04~noble
COMPOSE_PLUGIN=5.7.1-1~ubuntu.24.04~noble
BUILDX_PLUGIN=0.39.0-1~ubuntu.24.04~noble
# Huella de la clave con que Docker firma su repositorio (se comprueba en cloud-init antes de usarla).
DOCKER_GPG_HUELLA=9DC858229FC7DD38854AE2D88D81803C0EBFCD88

# ── ThingsBoard CE ─────────────────────────────────────────────────────────────────────────────────────────────────────────
# Principal: v4.3.1.8 (Apache-2.0; publicada el 26/10/2026). Sensibilidad: v4.4.0.2 (BSL 1.1; 30/10/2026).
TB_NODO=thingsboard/tb-node:4.3.1.8@sha256:5e2c180f3c48a9f4efd3e19d2f03c41b510ff1a935f25083657e0cf046a94872
TB_NODO_44=thingsboard/tb-node:4.4.0.2@sha256:b827d10aa022872a3c1114faa6b90b4b74b7d7b260e404908fb09a70ccf5705f
# Su Compose dice `postgres:18`; el 25/11 esa etiqueta apunta a 18.7, publicada el 24/11 (menos de 7 días): se fija 18.6 (06/11).
TB_POSTGRES=postgres:18.6@sha256:e3d24f6906d0760bf4da0dae872415391ededefad23fd471c47dc53b0ddf3c42

# ── La carga ───────────────────────────────────────────────────────────────────────────────────────────────────────────────
# Cliente MQTT del generador: el mismo paquete y versión que usa el backend (plataforma/backend/package.json).
MQTT_NPM=mqtt@5.16.1
