// Plantilla de include/secretos.h (fase 2, docs/17 §6.2). Copiar a include/secretos.h y completar; git ignora ese archivo
// (.gitignore) y NUNCA se versiona con valores reales: trae la clave de la red, la credencial del dispositivo y la dirección del servidor.
//   cp include/secretos.h.ejemplo include/secretos.h
// El binario compilado con este archivo (.pio/build/nodo/firmware.bin y .elf) lleva estos valores en claro: no se entrega ni se sube.
#pragma once

#define WIFI_SSID         "nombre-de-la-red-wifi"
#define WIFI_CLAVE        "clave-de-la-red-wifi"

// Dirección del proxy (la IP del portátil en la red, o un nombre que el nodo pueda resolver) y su puerto MQTT sobre TLS.
#define MQTT_HOST         "ip-del-portatil"
#define MQTT_PUERTO       8883

// Servidor NTP: sin hora no se publica la marca de tiempo (bt) y el backend usa la hora de recepción (docs/13 regla 7).
#define NTP_SERVIDOR      "pool.ntp.org"

// Del alta por API (POST /dispositivos): el código del sitio, el id_fisico (que es también el usuario del broker) y la credencial.
#define SITIO             "uct"
#define DISPOSITIVO_ID    "nodo-0001"
#define DISPOSITIVO_CLAVE "la-credencial-que-devolvio-el-alta"

// La CA de desarrollo (privado/certs-desarrollo/ca.crt), pegada tal cual entre los delimitadores: solo el certificado público, nunca
// una .key. Con ella el nodo verifica el certificado del proxy (nombre «proxy» de su SAN).
static const char CA_PEM[] = R"CA(
-----BEGIN CERTIFICATE-----
PEGAR AQUI EL CONTENIDO DE ca.crt
-----END CERTIFICATE-----
)CA";
