{
  "name": "plataforma-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Backend de la plataforma de registro, monitoreo y gestión de datos de sensores",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22 <23",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@12.3.4",
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "lint": "eslint \"src/**/*.ts\"",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "verificar": "pnpm typecheck && pnpm lint && pnpm test",
    "openapi": "nest build && node dist/exportar-openapi.js"
  },
  "dependencies": {
    "@nestjs/common": "11.2.5",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.2.5",
    "@nestjs/platform-express": "11.2.5",
    "@nestjs/swagger": "11.4.7",
    "helmet": "8.3.0",
    "mqtt": "5.16.0",
    "pg": "8.23.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@nestjs/cli": "11.0.24",
    "@nestjs/schematics": "11.1.0",
    "@nestjs/testing": "11.2.5",
    "@types/express": "5.0.3",
    "@types/jest": "30.0.0",
    "@types/node": "22.18.6",
    "@types/pg": "8.15.5",
    "eslint": "10.10.0",
    "jest": "30.1.3",
    "ts-jest": "29.4.4",
    "ts-node": "10.9.2",
    "typescript": "5.9.2",
    "typescript-eslint": "8.70.0"
  },
  "jest": {
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.ts$": "ts-jest"
    },
    "testEnvironment": "node"
  }
}
