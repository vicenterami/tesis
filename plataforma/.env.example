# Copiar a `.env` y reemplazar TODOS los valores. El `.env` real está ignorado por git.
# Generar claves con:  openssl rand -base64 24

# Base de datos
DB_NOMBRE=plataforma
DB_USUARIO=plataforma
DB_CLAVE=CAMBIAR_ESTA_CLAVE

# Usuario MQTT interno para el healthcheck del broker (crear con mosquitto_passwd; ver README)
MQTT_SONDA_USUARIO=sonda
MQTT_SONDA_CLAVE=CAMBIAR_ESTA_CLAVE
