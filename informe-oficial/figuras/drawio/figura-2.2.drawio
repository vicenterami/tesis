        <mxCell id="6DCThCRo4TvbdaP000Xs-7" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=18;fontColor=#1F3A5F;strokeColor=#1F3A5F;fillColor=#FFFFFF;" value="el &lt;i&gt;dashboard&lt;/i&gt;&lt;br&gt;(navegador)" vertex="1">
          <mxGeometry height="48" width="150" x="694" y="367" as="geometry" />
        </mxCell>
        <mxCell id="6DCThCRo4TvbdaP000Xs-10" parent="1" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;spacingLeft=8;spacingRight=8;fontFamily=Helvetica;fontSize=14;fontColor=#000000;strokeColor=#C9D1CC;fillColor=#F2F4F3;" value="Los mensajes se organizan en &lt;b&gt;tópicos&lt;/b&gt;, con forma de ruta. En esta plataforma: &lt;font face=&quot;Courier New&quot;&gt;sitio/&amp;lt;sitio&amp;gt;/dispositivo/&amp;lt;id_fisico&amp;gt;/&amp;lt;magnitud&amp;gt;&lt;/font&gt;, por ejemplo &lt;font face=&quot;Courier New&quot;&gt;sitio/uct/dispositivo/dev-0001/temperatura&lt;/font&gt;; las pasarelas, bajo &lt;font face=&quot;Courier New&quot;&gt;sitio/&amp;lt;sitio&amp;gt;/pasarela/&amp;lt;id&amp;gt;/…&lt;/font&gt;&lt;br&gt;&lt;br&gt;El backend es el &lt;b&gt;único suscriptor&lt;/b&gt; (&lt;font face=&quot;Courier New&quot;&gt;sitio/#&lt;/font&gt;): recibe todo &lt;b&gt;sin necesidad de saber qué sensores existen&lt;/b&gt;. Cada dispositivo solo puede publicar en sus propios tópicos, y el &lt;i&gt;dashboard&lt;/i&gt; recibe los datos del backend, no del broker." vertex="1">
          <mxGeometry height="132" width="786" x="30" y="444" as="geometry" />
