        <mxCell id="6DCThCRo4TvbdaP000Xs-4" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=18;fontColor=#1F3A5F;strokeColor=#1F3A5F;fillColor=#FFFFFF;strokeColor=#2E7D5B;strokeWidth=2;fillColor=#F1F7F4;" value="&lt;b&gt;BROKER&lt;/b&gt;&lt;br&gt;&lt;br&gt;Mosquitto&lt;br&gt;&lt;br&gt;&lt;i&gt;recibe de quien&lt;br&gt;publica,&lt;br&gt;entrega a quien&lt;br&gt;se suscribe&lt;/i&gt;" vertex="1">
