# Seguridad de la cadena de suministro:
# pnpm >= 10 NO ejecuta los scripts de instalación (preinstall/postinstall) de las dependencias
# salvo que se autoricen una a una en pnpm-workspace.yaml (allowBuilds).
# Se deja explícito para que la política sea visible y no dependa de la versión.
ignore-scripts=true
# Versiones exactas al agregar dependencias (sin ^ ni ~): reproducibilidad.
save-exact=true
